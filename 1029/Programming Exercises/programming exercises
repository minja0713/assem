## 5. 소수 — 에라토스테네스의 체

### 문제 번역

에라토스테네스의 체를 사용하여 2부터 1000까지의 모든 소수를 생성하고 화면에 출력하는 프로그램을 작성하라.

### 풀이

배열의 각 인덱스를 해당 정수로 사용한다. 처음에는 모두 소수 후보로 표시하고, 각 소수의 배수를 합성수로 지운다.

```asm
INCLUDE Irvine32.inc

.data
isPrime BYTE 1001 DUP(1)

.code
main PROC
    mov BYTE PTR isPrime[0], 0
    mov BYTE PTR isPrime[1], 0

    mov ebx, 2

sieveOuter:
    mov eax, ebx
    imul eax, ebx
    cmp eax, 1000
    ja  sieveDone

    cmp BYTE PTR isPrime[ebx], 0
    je  nextCandidate

    mov esi, eax            ; 첫 배수 p*p

markMultiples:
    cmp esi, 1000
    ja  nextCandidate
    mov BYTE PTR isPrime[esi], 0
    add esi, ebx
    jmp markMultiples

nextCandidate:
    inc ebx
    jmp sieveOuter

sieveDone:
    mov esi, 2

displayLoop:
    cmp esi, 1000
    ja  displayDone

    cmp BYTE PTR isPrime[esi], 0
    je  nextNumber

    mov eax, esi
    push esi
    call WriteDec
    pop esi
    mov al, ' '
    call WriteChar

nextNumber:
    inc esi
    jmp displayLoop

displayDone:
    call CrLf
    exit
main ENDP
END main
```

